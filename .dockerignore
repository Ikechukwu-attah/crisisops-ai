# Version control
.git
.gitignore

# Dependencies (rebuilt inside Docker)
node_modules

# Next.js build output
.next
out
build

# Environment files — NEVER bake secrets into the image
.env
.env.local
.env.development
.env.production

# SQLite databases — use a mounted volume
*.db
*.db-journal
*.db-wal
*.db-shm

# Dev / test / docs that don't affect runtime
coverage
*.test.ts
*.spec.ts
docs
README.md
CLAUDE.md
AGENTS.md

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
*.log

# TypeScript incremental
*.tsbuildinfo
